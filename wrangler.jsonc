{
  "name": "cqnce-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Override in Cloudflare dashboard if using a private cQnce deployment
    "CQNCE_BASE_URL": "https://api.cqnce.app"
  },
  // KV namespace binding "OAUTH_CODES" must be configured in Cloudflare dashboard:
  // Workers & Pages → cqnce-mcp → Settings → Variables → KV Namespace Bindings
  // Variable: OAUTH_CODES → Namespace: (create "cqnce-mcp-oauth-codes" first)
}
